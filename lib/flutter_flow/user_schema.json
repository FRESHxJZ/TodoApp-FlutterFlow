{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "description": "Schema for user documents in the Todo App Firestore database",
  "type": "object",
  "properties": {
    "birthday": {
      "description": "The user's birthday",
      "type": "string",
      "format": "date-time"
    },
    "created_time": {
      "description": "The time when the user account was created",
      "type": "string",
      "format": "date-time"
    },
    "display_name": {
      "description": "The user's display name",
      "type": "string"
    },
    "email": {
      "description": "The user's email address",
      "type": "string",
      "format": "email"
    },
    "instagram_handle": {
      "description": "The user's Instagram handle",
      "type": "string"
    },
    "photo_url": {
      "description": "The URL of the user's profile photo",
      "type": "string",
      "format": "uri"
    },
    "uid": {
      "description": "The user's unique identifier",
      "type": "string"
    }
  },
  "required": [
    "birthday",
    "created_time",
    "display_name",
    "email",
    "uid"
  ]
}